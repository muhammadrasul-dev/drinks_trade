{
  "name": "drinks-trade",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "pnpm -r --workspace-concurrency=1 --if-present run test:int",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait postgres",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:logs": "docker compose -f docker/compose.dev.yml logs -f postgres",
    "db:generate": "pnpm --filter @drinks/db generate",
    "db:migrate": "pnpm --filter @drinks/db migrate",
    "db:reset": "pnpm --filter @drinks/db reset",
    "db:seed": "pnpm --filter @drinks/db seed",
    "db:seed:dev": "pnpm --filter @drinks/db seed:dev",
    "db:studio": "pnpm --filter @drinks/db studio",
    "user:reset-password": "pnpm --silent --filter @drinks/server user:reset-password"
  },
  "devDependencies": {
    "@drinks/config": "workspace:*",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
